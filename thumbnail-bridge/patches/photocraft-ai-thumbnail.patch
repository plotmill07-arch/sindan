+#[cfg(test)]
+mod tests {
+    use super::*;
+    use photocraft_doc::{Layer, Size};
+
+    fn doc_with_reference() -> Document {
+        let mut d = Document::new("t", Size::new(8, 8), photocraft_color::ColorMode::Rgb, photocraft_color::SampleType::U8);
+        let mut r = Layer::raster(REFERENCE_LAYER, d.pixel_format());
+        r.visible = false;
+        let id = r.id;
+        d.layers.push(r);
+        d.layers.push(Layer::raster("背景", d.pixel_format()));
+        d.metadata.text.push((META_KEY.into(), json!({"reference_layer": id.0, "texts": []}).to_string()));
+        d
+    }
+
+    #[test]
+    fn finds_the_reference_layer_by_record_or_name() {
+        let d = doc_with_reference();
+        assert!(reference_layer(&d).is_some());
+        let mut plain = d.clone();
+        plain.metadata.text.clear();
+        assert_eq!(reference_layer(&plain), reference_layer(&d));
+        let mut none = Document::new("n", Size::new(4, 4), photocraft_color::ColorMode::Rgb, photocraft_color::SampleType::U8);
+        none.layers.push(Layer::raster("x", none.pixel_format()));
+        assert!(reference_layer(&none).is_none());
+    }
+
+    #[test]
+    fn commands_without_the_service_fail_gracefully() {
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), crate::Services::default());
+        let ctx = egui::Context::default();
+        assert_eq!(is_enabled(&app, "file.import.aiThumbnails"), Some(false));
+        assert!(menu(&mut app, &ctx, "file.import.aiThumbnails", &json!({})).is_some_and(|r| r.is_err()));
+        assert!(menu(&mut app, &ctx, "aiThumbnail.decompose", &json!({})).is_some_and(|r| r.is_err()));
+        assert!(menu(&mut app, &ctx, "aiThumbnail.compare", &json!({})).is_some_and(|r| r.is_err()));
+        assert!(menu(&mut app, &ctx, "aiThumbnail.export", &json!({"format": "gif"})).is_some_and(|r| r.is_err()));
+        assert!(menu(&mut app, &ctx, "not.ours", &json!({})).is_none());
+    }
+
+    #[test]
+    fn compare_toggles_show_only_the_original() {
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), crate::Services::default());
+        app.session.add_document(doc_with_reference(), None);
+        assert_eq!(is_enabled(&app, "aiThumbnail.compare"), Some(true));
+        compare(&mut app).unwrap();
+        let vis = |app: &PhotocraftApp| app.session.active().unwrap().doc.layers.iter().map(|l| l.visible).collect::<Vec<_>>();
+        assert_eq!(vis(&app), vec![true, false]);
+        compare(&mut app).unwrap();
+        assert_eq!(vis(&app), vec![false, true]);
+    }
+}
