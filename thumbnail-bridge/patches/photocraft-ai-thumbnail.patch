+
+/// Photoshop: double-clicking type with the Move tool switches to the Type tool and puts the
+/// caret where the pointer is, editing the existing layer (not a new one).
+#[test]
+fn move_tool_double_click_edits_type_at_the_click() {
+    let mut app = new_app();
+    let id = LayerId(app.run("type.create", json!({"text": "HOHOHO", "size": 90, "x": 300, "y": 420})).unwrap()["layer"].as_u64().unwrap());
+    app.ui.tool = crate::state::Tool::Move;
+    // 60 fps, so the two clicks fall inside egui's 0.3 s double-click window.
+    let mut h = Harness::builder().with_size(vec2(1200.0, 800.0)).with_step_dt(1.0 / 60.0).build_ui_state(
+        |ui, app: &mut PhotocraftApp| {
+            let ctx = ui.ctx().clone();
+            if !ctx.fonts(|f| f.families().contains(&egui::FontFamily::Name("medium".into()))) {
+                return;
+            }
+            crate::shortcuts::handle(app, &ctx);
+            egui::CentralPanel::default().show(ui, |ui| crate::canvas::document_area(app, ui));
+        },
+        app,
+    );
+    PhotocraftApp::setup_context(&h.ctx, crate::theme::ThemeKind::ALL[0]);
+    h.run_steps(4);
+    let p = glyph(&mut h, id, 3, 0.2);
+    h.hover_at(p);
+    h.run_steps(1);
+    for _ in 0..2 {
+        h.event(egui::Event::PointerButton { pos: p, button: PointerButton::Primary, pressed: true, modifiers: Modifiers::NONE });
+        h.event(egui::Event::PointerButton { pos: p, button: PointerButton::Primary, pressed: false, modifiers: Modifiers::NONE });
+        h.run_steps(1);
+    }
+    h.run_steps(2);
+    let app = h.state();
+    let ed = app.ui.text_edit.clone().expect("double-click enters type editing");
+    assert_eq!(ed.layer, id.0);
+    assert!(!ed.created, "edits the existing layer");
+    assert_eq!((ed.anchor, ed.caret), (3, 3));
+    assert_eq!(app.ui.tool, crate::state::Tool::Type);
+    // A double-click on empty canvas with the Move tool does nothing.
+    let mut app = new_app();
+    app.ui.tool = crate::state::Tool::Move;
+    assert!(!crate::type_tool::edit_at(&mut app, 50.0, 50.0));
+    assert!(app.ui.text_edit.is_none());
+}
