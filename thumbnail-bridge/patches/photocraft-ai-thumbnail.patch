+//! File › Import › AI Thumbnails: the native side of `photocraft_ui_egui::ai_thumbnail_ui`,
+//! backed by the Plotmill AI Thumbnail Bridge (local ONNX OCR / segmentation, font matching
+//! through PhotoCraft's own type engine). Models load once, on first use, from the folder the
+//! bridge's `scripts/setup.sh` fills; nothing is sent over the network.
+
+use std::sync::atomic::AtomicBool;
+use std::sync::{Arc, OnceLock};
+
+use photocraft_ui_egui::ai_thumbnail_ui::{Outcome, Progress, Request, Service};
+use plotmill_bridge::{Canvas, Engines, Options, Stage};
+use serde_json::{Value, json};
+
+static ENGINES: OnceLock<Result<Engines, String>> = OnceLock::new();
+
+fn run(req: Request, progress: Progress<'_>, cancel: &AtomicBool) -> Result<Outcome, String> {
+    let t = std::time::Instant::now();
+    progress("AIモデルを読み込み中");
+    let engines = ENGINES.get_or_init(|| Engines::load().map_err(|e| e.to_string())).as_ref().map_err(Clone::clone)?;
+    let img = plotmill_bridge::decode_image(&req.name, &req.bytes).map_err(|e| e.to_string())?;
+    let o = &req.options;
+    let opts = Options {
+        canvas: if o["canvas"].as_str() == Some("original") { Canvas::Original } else { Canvas::Youtube },
+        person: o["person"].as_bool().unwrap_or(true),
+        decorations: o["decorations"].as_bool().unwrap_or(true),
+        ..Default::default()
+    };
+    let stem = std::path::Path::new(&req.name).file_stem().map(|s| s.to_string_lossy().into_owned()).unwrap_or_else(|| "thumbnail".into());
+    let on_stage = |s: Stage| progress(s.label_ja());
+    let (document, d) = plotmill_bridge::convert_image(engines, &stem, &img, &opts, &on_stage, cancel).map_err(|e| e.to_string())?;
+    let texts: Vec<Value> = d
+        .lines
+        .iter()
+        .filter_map(|l| l.fits.first().map(|f| json!({"text": f.text, "font": f.face.family, "fontStyle": f.face.style, "sizePx": f.size_px, "score": f.score})))
+        .collect();
+    let report = json!({"texts": texts, "notes": d.notes, "person": d.person.is_some(), "decorations": d.plates.len(), "seconds": t.elapsed().as_secs_f32()});
+    Ok(Outcome { document, report })
+}
+
+fn status() -> Vec<(String, String)> {
+    let mut v = plotmill_bridge::models::status();
+    let faces = plotmill_bridge::fontmatch::japanese_faces();
+    let names: Vec<String> = faces.iter().map(|f| format!("{} {}", f.family, f.style)).collect();
+    v.push(("日本語フォント / Japanese fonts".into(), format!("{}: {}", faces.len(), names.join(", "))));
+    v
+}
+
+pub fn service() -> Option<Service> {
+    Some(Service { run: Arc::new(run), status: Arc::new(status) })
+}
